<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <ros2_control name="MobileBaseHardwareInterface" type="system">
        <hardware>
            <xacro:if value="$(arg use_mock_components)">
                <!--* Mock components: Somente para validação sem hardware real -->
                <plugin>mock_components/GenericSystem</plugin>
            </xacro:if>
            <xacro:unless value="$(arg use_mock_components)">
                <!--* Mobile base hardware interface: Para controle real do robô -->
                <plugin>mobile_base_hardware/MobileBaseHWInterface</plugin>
                <!-- Mapa afim do ESC (B-G431B-ESC1) em rad/s de RODA:
                     piso = 1000 rpm de motor (1520/1480us) e escala cheia = 5364 rpm
                     (2000/1000us), gearbox 1:28. Refinar com a varredura de pulsos de
                     docs/calibracao_odometria.md sem precisar recompilar. -->
                <!-- Firmware Caramelo 2026-07: speed_min 300 rpm (era 1000).
                     300 rpm / gearbox 28 * 2*pi/60 = 1.12 rad/s de roda.
                     SO VALE com os 4 ESCs regravados com o firmware novo! -->
                <!-- 2026-07-27: firmware ESC com speed_min 300->650 rpm (operador).
                     650 rpm de motor = 650/300 * 1.12 = 2.43 rad/s de RODA.
                     REGRA: este valor casa com speed_min_valueRPM do firmware
                     (mc_parameters.c) — mudar la' = mudar aqui (e rebuild PC+Pi). -->
                <param name="min_wheel_rad_per_sec">2.43</param>
                <param name="max_wheel_rad_per_sec">20.06</param>
                <!-- Watchdog: sem write() por mais que isso -> PWM neutro. -->
                <param name="command_timeout_s">0.5</param>
                <!-- Trim por RAMO de pulso (us; +N = ramo mais rapido).
                     Calibrado no chao 2026-07-29 (3m + trena, ida E volta):
                     ramo de FRENTE rodava ~8% abaixo do mapa (re batia exato)
                     -> guinada de ~23 graus em 3,4m. Deficit ~7,3us -> 8.
                     Recalibrar com o mesmo teste se trocar ESC/firmware. -->
                <param name="pulse_trim_forward_us">8.0</param>
                <param name="pulse_trim_reverse_us">0.0</param>
                <!-- ENCODER (2026-09-01): quadratura x4 por amostragem do RIO do
                     RP1. 1024 ciclos por canal por volta de motor x gearbox 1:28
                     x 4 = 114688 counts por volta de RODA. Confirmado na bancada
                     girando cada roda 3 voltas a mao (112.7k a 113.1k medidos; o
                     deficit de ~2% e' candidato a erro de marcacao OU a razao de
                     reducao fracionaria, e sera' resolvido na calibracao de
                     odometria com trena, onde entra no wheels_radius). -->
                <param name="encoder_counts_per_wheel_rev">114688.0</param>
                <!-- Amostras de permanencia para aceitar um estado (filtro de
                     glitch). A/B medido: com 1, o ruido das fases do motor no
                     chicote do proprio encoder produziu 232 e 194 transicoes
                     ilegais em FL e BR; com 8, ZERO nas quatro, sem perder
                     contagem. 8 amostras = ~1.5 us a 5.4 MHz, contra 2.73 us de
                     intervalo minimo entre transicoes na velocidade maxima. -->
                <param name="encoder_stable_samples">8</param>
                <!-- Core da thread de amostragem. So' com a thread PRESA num core
                     ela sobe para SCHED_FIFO; sem isso roda em prioridade normal
                     de proposito, porque uma thread de tempo real em laco fechado
                     sem core proprio TRAVA a maquina (aconteceu em 2026-09-01: os
                     spawners nunca alcancaram o controller_manager, load 14).
                     Este core deve estar isolado por isolcpus no cmdline.txt. -->
                <param name="sampler_cpu">3</param>
                <!-- FAILSAFE: pode CORTAR os pulsos quando o laco de controle
                     morre? true SO vale com o firmware novo dos ESCs, em que
                     Ton=0 PARA o motor (confirmado pelo operador em 2026-09-01).
                     Com o firmware ANTIGO, perda de PWM e' interpretada como RE
                     EM VELOCIDADE MAXIMA, e o estado seguro passa a ser neutro
                     sustentado — por isso isto e' parametro e nao constante:
                     uma Pi com ESC antigo nao pode herdar o comportamento novo
                     em silencio. -->
                <param name="esc_failsafe_cut_pulses">true</param>
            </xacro:unless>
        </hardware>

        <!-- Criar uma joint tag para cada junta que desejar que seja controlada -->
        <!-- O nome da junta aqui deve corresponder ao nome da junta no URDF -->
        <joint name="front_left_wheel_joint"> <!--* Roda dianteira esquerda -->
            <!-- Especificar as interfaces de comando e estado para a junta direita -->
            <command_interface name="velocity" />   <!-- Interface de comando para velocidade (O que o controle espera de entrada)-->
            <!-- OFFSET DE PULSO DESTA PLACA (us). Compensa o zero do ESC: o
                 oscilador de cada B-G431B-ESC1 tem tolerancia propria, entao o
                 pulso que a placa MEDE nao e' o que a Pi ENVIA.
                 Medido em 2026-09-01 com bateria carregada, varredura em 3, 6 e
                 10 rad/s nos dois sentidos, com o mesmo ponto no inicio e no fim
                 como controle (bateu em 0,17%: sem sag durante o teste).
                 O erro medido e' CONSTANTE com a velocidade e tem o MESMO sinal
                 nos dois ramos -> offset de pulso, nao erro de ganho.
                 Sem isto, as rodas da direita rodavam 6% mais devagar que as da
                 esquerda para frente, o que no chao vira guinada. -->
            <param name="pulse_offset_us">0.0</param>
            <state_interface name="position" />     <!-- Interface de estado para posição (O que o hardware reporta como saída)-->
            <state_interface name="velocity" />
        </joint>

        <joint name="front_right_wheel_joint"> <!--* Roda dianteira direita -->
            <command_interface name="velocity" />
            <!-- Offset desta placa: erro medido -11.05 us. Ver a nota completa na front_left. -->
            <param name="pulse_offset_us">0.0</param>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="back_left_wheel_joint"> <!--* Roda traseira esquerda -->
            <command_interface name="velocity" />
            <!-- Offset desta placa: erro medido -2.01 us. Ver a nota completa na front_left. -->
            <param name="pulse_offset_us">0.0</param>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="back_right_wheel_joint"> <!--* Roda traseira direita -->
            <command_interface name="velocity" />
            <!-- Offset desta placa: erro medido -11.36 us. Ver a nota completa na front_left. -->
            <param name="pulse_offset_us">0.0</param>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

    </ros2_control>

</robot>
